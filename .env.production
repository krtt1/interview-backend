# Production Environment Variables
# สำหรับ Deploy บน Railway

NODE_ENV=production
PORT=3011

# Database Configuration (MySQL on Railway)
# ⚠️ ต้องตั้งค่า MYSQL_PUBLIC_URL ใน Railway Dashboard Variables
# ตัวอย่าง: mysql://root:password@mysql.railway.internal:3306/railway
MYSQL_PUBLIC_URL=mysql://root:IGkoiDfcbvrdUKkemKqAwiKmkEvLoEwS@mysql.railway.internal:3306/railway

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# JWT Secret
JWT_SECRET=my_super_secret_key_2026_xyz

# Database SSL
DB_SSL=false

# Allow test user endpoint
ALLOW_TEST_USER=true
