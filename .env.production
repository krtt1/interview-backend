# Production Environment Variables
# สำหรับ Deploy บน Railway

NODE_ENV=production
PORT=3011

# Database Configuration (MySQL on Railway)
# ⚠️ ต้องตั้งค่า MYSQL_PUBLIC_URL ใน Railway Dashboard
# Format: mysql://username:password@host:port/database
# ใช้ reference ไปยัง MySQL Plugin variables
MYSQL_PUBLIC_URL=${{ MySQL.DATABASE_URL }}

# CORS Configuration
# เพิ่ม Frontend URL ของคุณที่นี่
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# JWT Secret (สร้างใหม่สำหรับ production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database SSL (ปกติ false สำหรับ Railway)
DB_SSL=false

# Allow test user endpoint in production (สำหรับ testing)
ALLOW_TEST_USER=true
