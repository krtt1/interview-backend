# Production Environment Variables
# สำหรับ Deploy บน Railway

NODE_ENV=production
PORT=3011

# Database Configuration (MySQL on Railway)
# ⚠️ ต้องตั้งค่า MYSQL_PUBLIC_URL ใน Railway Dashboard Variables เท่านั้น
# ไม่ควร hardcode ใน .env.production เพราะมี password
# ตัวอย่าง: mysql://root:password@monorail.proxy.rlwy.net:XXXXX/railway

# CORS Configuration
ALLOWED_ORIGINS=https://interview-frontend-pnh8r2me2-krtt1s-projects.vercel.app

# JWT Secret
JWT_SECRET=my_super_secret_key_2026_xyz

# Database SSL
DB_SSL=true

# Allow test user endpoint
ALLOW_TEST_USER=true
